# Copy to .env and fill in.  run.py loads .env automatically.
TYPESAFE_API_KEY=your_key_here
# Optional overrides:
# JEV_MODEL=jev-1.13.0
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# GENERATIVE_API_KEY=
# GENERATIVE_BASE_URL=https://api.openai.com/v1
# GENERATIVE_MODEL=gpt-4o-mini
# Discovery (discover.py). Search-grounded Groq model; list yours with: python3 discover.py models
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=openai/gpt-oss-20b
