# Copy to /etc/fleet.env on the server, chmod 600, owned by root.  Never commit the real file.

# --- access -------------------------------------------------------------
# Long random string; generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FLEET_ADMIN_TOKEN=

# --- free hosted models (pick ONE block) --------------------------------
# Groq (OpenAI-compatible).  Get a key at console.groq.com.
FLEET_BASE_URL=https://api.groq.com/openai/v1
FLEET_API_KEY=
# Gemini (OpenAI-compatible) instead:
# FLEET_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FLEET_API_KEY=
#
# Model ladder: cheapest first.  Names and free limits change; list what your key can use
# (curl -H "Authorization: Bearer $FLEET_API_KEY" $FLEET_BASE_URL/models) and fill these in.
FLEET_TIER0=
FLEET_TIER1=
FLEET_TIER2=
FLEET_ORCH_MODEL=
# Model judge is off for free providers (saves calls); the deterministic QA gates always run.
# FLEET_JUDGE=1

# --- email (Gmail with an app password, port 587) ------------------------
FLEET_SMTP_HOST=smtp.gmail.com
FLEET_SMTP_USER=
FLEET_SMTP_PASS=
FLEET_DAILY_SEND_CAP=20

# --- payments ------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=

# --- Caddy: public hostname.  No domain? use <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-5.sslip.io
FLEET_HOST=
