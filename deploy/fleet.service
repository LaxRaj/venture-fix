[Unit]
Description=Venture fleet (agents, approval queue, Stripe webhook)
After=network-online.target
Wants=network-online.target

[Service]
User=fleet
WorkingDirectory=/opt/venture-fix
EnvironmentFile=/etc/fleet.env
# Loopback only: Caddy terminates HTTPS in front.  --require-token refuses to start without FLEET_ADMIN_TOKEN.
ExecStart=/usr/bin/python3 /opt/venture-fix/fleetapp.py --host 127.0.0.1 --port 8780 --require-token --provider openai --top 3 --auto 900 --budget 1000000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/venture-fix/runs

[Install]
WantedBy=multi-user.target
